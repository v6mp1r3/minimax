# DocuGuide — Gemini primary
# IMPORTANT: Ollama is NOT used automatically.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=none

# Get a key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional cloud fallback. Leave empty if you only want Gemini.
# OPENROUTER_API_KEY=
# AI_FALLBACK_PROVIDER=openrouter
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional local fallback. Enable explicitly only if Ollama is installed.
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192

# Retrieval / demo settings
LLM_MAX_PROMPT_CHARS=14000
LLM_TIMEOUT_SECONDS=45
CACHE_TTL_SECONDS=7200
ENABLE_CLARIFICATIONS=false

# Gemini transient error handling (503/429/5xx)
GEMINI_RETRIES=3
